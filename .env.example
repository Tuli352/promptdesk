# Copy this file to .env.local and fill in your own values.

# "sandbox" or "production"
MPESA_ENV=sandbox

# From developer.safaricom.co.ke -> your app
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# STK push (Lipa na M-Pesa Online)
MPESA_SHORTCODE=174379
MPESA_PASSKEY=

# B2C withdrawals (money from your shortcode to your own number)
MPESA_B2C_SHORTCODE=600000
MPESA_INITIATOR_NAME=testapi
MPESA_INITIATOR_PASSWORD=
# Path to Safaricom's public certificate (SandboxCertificate.cer or ProductionCertificate.cer)
MPESA_CERT_PATH=./certs/SandboxCertificate.cer

# Public HTTPS address of this app. Safaricom must be able to reach it.
# While developing, use a tunnel such as ngrok and paste its https URL here.
APP_BASE_URL=https://your-public-url.example.com

# Secret you make up. It is added to the callback URLs so strangers cannot post fake results.
CALLBACK_SECRET=change-me-to-a-long-random-string

# Database for Vercel (Upstash Redis). Vercel fills these in for you when you add the store.
# Leave them empty on your own computer to use a local file instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
